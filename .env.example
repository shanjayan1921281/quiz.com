# Production Full-Stack LiveQuiz Configuration

# Server Port
PORT=3000

# PostgreSQL Database (e.g. Railway PostgreSQL or local)
# If empty or unreachable, server uses reliable zero-config in-memory fallback.
DATABASE_URL="postgresql://postgres:password@localhost:5432/livequiz_db"

# Admin Authentication
JWT_SECRET="livequiz-college-championship-secret-key-2026"
ADMIN_DEFAULT_EMAIL="admin@college.edu"
ADMIN_DEFAULT_PASSWORD="AdminCollege2026!"

# CORS Configuration
FRONTEND_URL="*"

# Client-Side Environment Variables (Vite / Vercel)
# Leave blank to use current origin /ws and /api automatically
VITE_API_URL=""
VITE_WS_URL=""
